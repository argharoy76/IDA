# ==============================================================================
# IMPERIAL DEFENCE ACADEMY (IDA) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' on your server or local environment:
#      cp .env.example .env
# 2. Generate a secure application key:
#      php artisan key:generate
# 3. Fill in your environment-specific credentials below.
# 4. NEVER commit the actual '.env' file to your Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# APP_NAME: Display name of the institution across templates, titles, and emails.
APP_NAME="Imperial Defence Academy"

# APP_ENV: 'local' for local development; 'production' for live Hostinger deployment.
# IMPORTANT: In 'production', debug mode is disabled, sensitive errors are masked,
# and HTTPS is automatically enforced.
APP_ENV=production

# APP_KEY: 32-character encryption key. Generate with 'php artisan key:generate'.
APP_KEY=

# APP_DEBUG: Set to 'false' in production. 'true' reveals stack traces and credentials.
APP_DEBUG=false

# APP_TIMEZONE: Application timezone. Standard for Bangladesh is Asia/Dhaka.
APP_TIMEZONE=Asia/Dhaka

# APP_URL: Full canonical root URL of your website with HTTPS in production.
# Examples:
#   Production: https://yourdomain.com
#   Local XAMPP: http://localhost/ida
#   Local Artisan: http://127.0.0.1:8000
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------------------
# 2. LOGGING & SECURITY
# ------------------------------------------------------------------------------
# LOG_CHANNEL: 'stack' logs to storage/logs/laravel.log.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# LOG_LEVEL: 'error' or 'warning' in production; 'debug' in local development.
LOG_LEVEL=error

# BCRYPT_ROUNDS: Work factor for password hashing (12 is recommended for production).
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# FOR HOSTINGER PRODUCTION (MySQL / MariaDB):
# 1. Create a MySQL database and user in Hostinger hPanel -> Databases.
# 2. Use 127.0.0.1 (or localhost) as DB_HOST.
# 3. Enter your Hostinger database name, username, and password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_ida
DB_USERNAME=u123456789_ida_user
DB_PASSWORD=your_strong_database_password

# FOR LOCALHOST DEVELOPMENT (SQLite alternative):
# To use SQLite locally, uncomment the lines below and comment out the MySQL block:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# DB_FOREIGN_KEYS=true

# ------------------------------------------------------------------------------
# 4. SESSION & STATE MANAGEMENT
# ------------------------------------------------------------------------------
# SESSION_DRIVER: 'database' stores sessions in the database for persistence across worker restarts.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------------------------------------
# 5. CACHE & PERFORMANCE
# ------------------------------------------------------------------------------
# CACHE_STORE: 'database' or 'file'. In shared hosting, 'database' or 'file' is recommended.
CACHE_STORE=database
CACHE_PREFIX=ida_cache_

# ------------------------------------------------------------------------------
# 6. QUEUES & BACKGROUND JOBS
# ------------------------------------------------------------------------------
# QUEUE_CONNECTION: 'database' for asynchronous jobs, or 'sync' for immediate execution.
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# 7. FILESYSTEM & ASSET STORAGE
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# 8. EMAIL & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Configure with Hostinger Webmail or external SMTP (e.g. Gmail, SendGrid).
# Hostinger SMTP settings:
#   Host: smtp.hostinger.com
#   Port: 465 (SSL) or 587 (TLS)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@your-domain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
